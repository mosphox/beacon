# ---------------------------------------------------------------- listeners
# Plain HTTP, published on the host.
#
# Loopback by default, and deliberately not port 80: the intended deployment has
# Caddy on the edge already holding :80 and :443, and Docker publishes straight
# past a host firewall into the DOCKER chain, so 0.0.0.0:80 here is both a bind
# conflict that aborts the deploy and a listener on every interface.
# The port is high and unusual on purpose. This listener is loopback-only and
# nothing outside the host should reach it, so there is no value in a memorable
# number — and 8080 is one of the most commonly occupied ports there is, which
# on the first real host it met was already taken.
# Change these only if nothing else is fronting beacon.
HOST=127.0.0.1
PORT=11001

# Host mapping for the TLS listener, only meaningful when TLS_ENABLED=true.
# This is what the edge proxy's upstream dials, so it has to be a fixed port —
# left commented, compose publishes 8443 on a *random* host port and the edge
# connects to a closed one. Keep it on loopback: the proxy passes TLS through
# to it, nothing else should reach it.
TLS_PUBLISH=127.0.0.1:8443:8443

# ------------------------------------------------------------- geoip sources
# DB-IP Lite needs no account and is on by default.
DBIP_ENABLED=true

# MaxMind GeoLite2 is optional. Set both or neither; a free account provides
# them. With both sources enabled, answers that differ are attributed.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

GEOIP_UPDATE_INTERVAL_HOURS=12

# ------------------------------------------------------------------- client
# Believe X-Real-IP / X-Forwarded-For.
#
# Off by default, and only turn it on if every listener above is unreachable
# except through a proxy that overwrites these headers. A client controls its
# own headers, so trusting them anywhere it can reach beacon directly means it
# picks the address beacon reports — which is the one thing this service is for,
# and also what drives the GeoIP lookup and the outbound PTR query.
#
# PROXY protocol does not need this: it carries the true peer itself, and when
# it is on these headers are stripped regardless of what is set here.
TRUST_PROXY_HEADERS=false

# Look up the caller's PTR record. Adds a DNS round trip to uncached lookups.
RDNS_ENABLED=true

# ---------------------------------------------------------------------- tls
# Terminate TLS in beacon, with certificates from ACME over the DNS-01
# challenge. Needed for TLS fingerprinting: a proxy that terminates TLS
# consumes the ClientHello and it cannot be recovered downstream.
TLS_ENABLED=false

# Comma-separated. Required when TLS_ENABLED=true.
DOMAIN=

# Cloudflare API *token* (not a global key) with Zone:Read + Zone.DNS:Write.
# Optionally scope it: put a Zone:Read token in CF_ZONE_TOKEN and a
# Zone.DNS:Write token for just this zone in CF_API_TOKEN.
CF_API_TOKEN=
CF_ZONE_TOKEN=

# Contact address for expiry notices. Leave it empty and Let's Encrypt has no
# way to warn you before a certificate expires — treat it as required.
ACME_EMAIL=

# Which CA to use. Staging by default, and leave it there until you have seen a
# certificate actually land in the data volume.
#
# Production has a limit of 5 failed validations per hostname per hour, and a
# failure at startup is fatal: the container exits and restarts immediately,
# so a wrong DOMAIN or a token missing Zone.DNS:Write burns that budget in well
# under a minute and locks you out for an hour. Switch to production only after
# a staging issuance has succeeded.
ACME_CA=staging

# Read a PROXY protocol header before the TLS handshake, so the real client
# address survives a TCP-level proxy. Enable together with the edge config
# that sends it. When on, forwarded headers are ignored on the TLS listener:
# the PROXY header is authoritative and the request's own headers are not.
PROXY_PROTOCOL=false

# Advanced: in-container bind addresses and reverse-DNS tuning.
# LISTEN_ADDR=:8000
# TLS_LISTEN_ADDR=:8443
# FRONTEND_URL=http://frontend:3000   (empty disables the web page entirely)
# RDNS_TIMEOUT_MS=300
# RDNS_CACHE_TTL_SECONDS=3600
